IC_APP_NAME=incident-copilot
IC_ENV=dev
IC_DATA_DIR=./data
IC_INDEX_DB_PATH=./data/indexes/repo_index.db
# Set false to bypass native parsing; requires recreating the API and worker containers.
IC_TREE_SITTER_ENABLED=true
# Stable bootstrap location, shared by API and worker. Dashboard storage edits do not move this file.
IC_CONTROL_DB_PATH=./data/control.db
# Docker host directory mounted read-only at /repositories.
IC_REPOSITORIES_DIR=.

IC_TEMPORAL_HOST=temporal:7233
IC_TEMPORAL_NAMESPACE=default
IC_TEMPORAL_TASK_QUEUE=incident-copilot

# LiteLLM starts with the main Compose stack and routes to Ollama by default.
# Generate a private key before starting Compose; see docs/litellm.md.
LITELLM_MASTER_KEY=
LITELLM_MODEL=ollama_chat/llama3.1:8b
LITELLM_API_BASE=http://host.docker.internal:11434
LITELLM_API_KEY=ollama
# Optional override of the pinned gateway image in docker-compose.dev.yml.
# LITELLM_IMAGE=ghcr.io/berriai/litellm:1.106.4

# The application calls the gateway alias through the OpenAI-compatible adapter.
IC_LLM_PROVIDER=openai_compatible
# Host API/worker/CLI processes must use http://localhost:4000/v1 instead.
IC_OPENAI_COMPATIBLE_BASE_URL=http://litellm:4000/v1
IC_OPENAI_COMPATIBLE_MODEL=incident-diagnosis
IC_OPENAI_COMPATIBLE_API_KEY=${LITELLM_MASTER_KEY}
# Explicit direct-Ollama overrides remain available for development.
IC_OLLAMA_BASE_URL=http://host.docker.internal:11434
IC_OLLAMA_MODEL=llama3.1:8b

IC_TOP_K_CANDIDATES=10
IC_DEEP_ANALYSIS_TOP_N=5

# Read-only iterative investigation; checkpoints use IC_DATA_DIR/investigations.
IC_AGENTIC_ENABLED=false
IC_AGENTIC_MAX_ROUNDS=3
IC_AGENTIC_MAX_TOOL_REQUESTS=12
IC_AGENTIC_TIMEOUT_SECONDS=180

# Optional model policy checks. Enable observe first; review before choosing enforce.
IC_GUARDRAILS_MODE=off
IC_GUARDRAILS_TIMEOUT_SECONDS=10

# Graphs are prepared automatically by the Compose sidecar (docs/code-graph.md).
IC_CODE_GRAPH_ENABLED=true
IC_CODE_GRAPH_MODE=managed
IC_CODE_GRAPH_PREPARE_TIMEOUT_SECONDS=300
# Host processes with a separately prepared provider can use mode=external.
IC_GITNEXUS_URL=http://localhost:3111/mcp
# Optional indexed path inside the sidecar; blank uses the incident repository path.
IC_GITNEXUS_REPOSITORY=
IC_GITNEXUS_AUTH_TOKEN=
IC_CODE_GRAPH_TIMEOUT_SECONDS=15
