IC_APP_NAME=incident-copilot
IC_ENV=dev
IC_DATA_DIR=./data
IC_INDEX_DB_PATH=./data/indexes/repo_index.db
# Set false to bypass native parsing; requires recreating the API and worker containers.
IC_TREE_SITTER_ENABLED=true
# Stable bootstrap location, shared by API and worker. Dashboard storage edits do not move this file.
IC_CONTROL_DB_PATH=./data/control.db
# Docker host directory mounted read-only at /repositories.
IC_REPOSITORIES_DIR=.

IC_TEMPORAL_HOST=temporal:7233
IC_TEMPORAL_NAMESPACE=default
IC_TEMPORAL_TASK_QUEUE=incident-copilot

IC_LLM_PROVIDER=ollama
IC_OLLAMA_BASE_URL=http://host.docker.internal:11434
IC_OLLAMA_MODEL=llama3.1:8b

IC_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
IC_OPENAI_COMPATIBLE_MODEL=gpt-oss-20b
IC_OPENAI_COMPATIBLE_API_KEY=dummy

IC_TOP_K_CANDIDATES=10
IC_DEEP_ANALYSIS_TOP_N=5

# Read-only iterative investigation; checkpoints use IC_DATA_DIR/investigations.
IC_AGENTIC_ENABLED=false
IC_AGENTIC_MAX_ROUNDS=3
IC_AGENTIC_MAX_TOOL_REQUESTS=12
IC_AGENTIC_TIMEOUT_SECONDS=180

# Optional GitNexus evidence. Prepare the index before enabling (docs/code-graph.md).
IC_CODE_GRAPH_ENABLED=false
IC_GITNEXUS_URL=http://localhost:3111/mcp
# Optional indexed path inside the sidecar; blank uses the incident repository path.
IC_GITNEXUS_REPOSITORY=
IC_GITNEXUS_AUTH_TOKEN=
IC_CODE_GRAPH_TIMEOUT_SECONDS=15
